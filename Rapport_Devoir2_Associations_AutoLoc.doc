<!-- SCENARIO 3 -->
<h2>4. Scénario 3 : Association @ManyToMany (Affectation / Désaffectation Équipement)</h2>
<div class="scenario-card">
  <b>Énoncé :</b> Un véhicule et un équipement (siège bébé) existent déjà dans la base de données. Un client souhaite louer ce véhicule avec cet équipement. L'agent affecte le siège bébé au véhicule au départ, puis le désaffecte à son retour.<br>
  <code>public Vehicule affecterEquipement(Long idVehicule, Long idEquipement)</code><br>
  <code>public Vehicule desaffecterEquipement(Long idVehicule, Long idEquipement)</code>
</div>

<h3>4.1. Code Source de la Couche Service</h3>
<p><strong>Implémentation dans IVehiculeServiceImp :</strong></p>
<div class="code-box">@Override
@Transactional
public Vehicule affecterEquipement(Long idVehicule, Long idEquipement) {
    Vehicule vehicule = vehiculeRepository.findById(idVehicule).orElse(null);
    Equipement equipement = equipementRepository.findById(idEquipement).orElse(null);

    if (vehicule != null && equipement != null) {
        if (vehicule.getEquipements() == null) {
            vehicule.setEquipements(new ArrayList&lt;&gt;());
        }
        boolean exists = vehicule.getEquipements().stream()
                .anyMatch(e -&gt; e.getIdEquipement().equals(idEquipement));
        if (!exists) {
            vehicule.getEquipements().add(equipement);
        }
        return vehiculeRepository.save(vehicule);
    }
    return null;
}

@Override
@Transactional
public Vehicule desaffecterEquipement(Long idVehicule, Long idEquipement) {
    Vehicule vehicule = vehiculeRepository.findById(idVehicule).orElse(null);
    Equipement equipement = equipementRepository.findById(idEquipement).orElse(null);

    if (vehicule != null && equipement != null) {
        if (vehicule.getEquipements() != null) {
            vehicule.getEquipements().removeIf(e -&gt; e.getIdEquipement().equals(idEquipement));
        }
        return vehiculeRepository.save(vehicule);
    }
    return null;
}</div>

<h3>4.2. Contrôleur REST (VehiculeController)</h3>
<div class="code-box">@PutMapping({"/affecter-equipement/{idVehicule}/{idEquipement}", "/affecterEquipement/{idVehicule}/{idEquipement}"})
public Vehicule affecterEquipement(@PathVariable Long idVehicule, @PathVariable Long idEquipement) {
    return vehiculeService.affecterEquipement(idVehicule, idEquipement);
}

@PutMapping({"/desaffecter-equipement/{idVehicule}/{idEquipement}", "/desaffecterEquipement/{idVehicule}/{idEquipement}"})
public Vehicule desaffecterEquipement(@PathVariable Long idVehicule, @PathVariable Long idEquipement) {
    return vehiculeService.desaffecterEquipement(idVehicule, idEquipement);
}</div>

